{
  "manifest_version": 3,
  "name": "Nimble Scholar Capture",
  "description": "Save the current paper page into Nimble Scholar.",
  "version": "0.1.0",
  "action": {
    "default_title": "Save to Nimble Scholar",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://openreview.net/*"
  ]
}
